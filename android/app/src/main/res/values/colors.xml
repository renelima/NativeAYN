<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The icon's tile colour (NativeAYN's deep space tile, top of the gradient) -->
    <color name="ic_launcher_background">#FF0A1B33</color>

    <!-- NativeAYN's "Deep Space Cockpit" palette (Ui.java, themes.xml): NativeAYN is dark by design — the same set in day and night (values-night repeats it),
         a deep navy space with a bright teal primary, kept for handheld play in the dark. The names (bn_*) are internal; bn_banana is the primary (teal) -->
    <color name="bn_bg">#FF0B1220</color>            <!-- the screen: deep navy -->
    <color name="bn_card">#FF141E30</color>          <!-- cards and dialogs -->
    <color name="bn_card_stroke">#FF24344E</color>
    <color name="bn_tint">#FF1C2A42</color>          <!-- tonal buttons, icon tiles, chips -->
    <color name="bn_banana">#FF2DD4BF</color>        <!-- primary buttons: bright teal -->
    <color name="bn_banana_deep">#FF0D9488</color>
    <color name="bn_on_banana">#FF062A25</color>     <!-- text on the primary (both modes) -->
    <color name="bn_text">#FFE8EEF8</color>
    <color name="bn_text_2">#FF9FB2CC</color>
    <color name="bn_accent">#FF2DD4BF</color>        <!-- check boxes, switches, dialog buttons -->
    <color name="bn_leaf">#FF34D399</color>
    <color name="bn_on_leaf">#FF06231A</color>
    <color name="bn_danger">#FFF87171</color>
    <color name="bn_danger_tint">#FF3A1E24</color>
    <color name="bn_warn_tint">#FF3A2E1A</color>
</resources>
