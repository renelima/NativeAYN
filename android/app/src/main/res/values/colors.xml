<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The icon's tile colour (NativeAYN's tile, top of the gradient) -->
    <color name="ic_launcher_background">#FF2B2B2B</color>

    <!-- NativeAYN's "Console Shelf" palette (Ui.java, themes.xml): NativeAYN is dark by design — the same set in day and night (values-night repeats it),
         a flat charcoal screen with a sky-blue accent (the shelf's selection ring), kept for handheld play in the dark. The names (bn_*) are internal;
         bn_banana is the primary (blue) -->
    <color name="bn_bg">#FF262626</color>            <!-- the screen: flat charcoal -->
    <color name="bn_card">#FF313131</color>          <!-- cards and dialogs -->
    <color name="bn_card_stroke">#FF404040</color>
    <color name="bn_tint">#FF3B3B3B</color>          <!-- tonal buttons, icon tiles, chips -->
    <color name="bn_banana">#FF2AA7E6</color>        <!-- primary buttons: sky blue -->
    <color name="bn_banana_deep">#FF1176B8</color>
    <color name="bn_on_banana">#FFF2FAFF</color>     <!-- text on the primary (both modes) -->
    <color name="bn_text">#FFF2F2F2</color>
    <color name="bn_text_2">#FFB9B9B9</color>
    <color name="bn_accent">#FF2AA7E6</color>        <!-- check boxes, switches, dialog buttons -->
    <color name="bn_leaf">#FF34D399</color>
    <color name="bn_on_leaf">#FF06231A</color>
    <color name="bn_danger">#FFF87171</color>
    <color name="bn_danger_tint">#FF43262B</color>
    <color name="bn_warn_tint">#FF43351F</color>
    <color name="bn_select">#FF17A8DE</color>        <!-- the ring around the selected game card on Home (the console shelf's blue) -->
</resources>
